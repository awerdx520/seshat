# seshat 服务 systemd 单元模板（可提交，部署时按环境修改）
#
# 用法：
#   1. cp deploy/seshat.service.example /etc/systemd/system/seshat.service 并按环境修改；
#   2. 准备 EnvironmentFile（/etc/seshat/secrets.env，权限 600，属主 root:seshat），
#      内容参考 deploy/seshat.env.example；
#   3. systemctl daemon-reload && systemctl enable --now seshat
#
# 安全：敏感值禁止写入本单元文件，仅通过 EnvironmentFile 注入，详见 docs/security.md。

[Unit]
Description=Seshat 个人笔记同步服务（单用户自托管知识中枢）
Documentation=file:/usr/share/doc/seshat/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seshat
Group=seshat
WorkingDirectory=/srv/seshat
# 敏感环境变量（SESHAT_DB_KEY / SESHAT_AUTH_TOKEN / SESHAT_NODE_TOKEN / SESHAT_LLM_API_KEY）由此文件注入。
EnvironmentFile=/etc/seshat/secrets.env
ExecStart=/usr/local/bin/seshat-server
Restart=on-failure
RestartSec=5s

# 最小权限加固（可选，按部署环境调整）。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/seshat

[Install]
WantedBy=multi-user.target
