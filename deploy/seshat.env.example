# seshat 服务敏感环境变量模板（可提交，值为占位符，禁止填入真实密钥）
#
# 用法：
#   1. cp deploy/seshat.env.example /etc/seshat/secrets.env
#   2. 运行 scripts/gen-secrets.sh 生成 SESHAT_DB_KEY、SESHAT_AUTH_TOKEN 与
#      SESHAT_NODE_TOKEN 并填入，
#      （或直接让脚本输出到该路径：scripts/gen-secrets.sh /etc/seshat/secrets.env）
#   3. chmod 600 /etc/seshat/secrets.env && chown root:seshat /etc/seshat/secrets.env
#
# 说明：本文件为可提交模板，仓库中不得出现真实密钥值；由 systemd 单元
#       deploy/seshat.service.example 通过 EnvironmentFile 加载，详见 docs/security.md。

# 数据库密钥（32 字节 hex，脚本生成）：存储层加密使用。
SESHAT_DB_KEY=<请用 scripts/gen-secrets.sh 生成>

# API 访问令牌（脚本生成）：REST Bearer 与 WebDAV Basic Auth 共用。
SESHAT_AUTH_TOKEN=<请用 scripts/gen-secrets.sh 生成>

# 本地 LLM 节点专用令牌（脚本生成）：仅保护节点端点（注册/轮询/回传，最小权限）。
# 未配置则节点端点回退使用主令牌 SESHAT_AUTH_TOKEN（向后兼容单令牌部署）。
SESHAT_NODE_TOKEN=<请用 scripts/gen-secrets.sh 生成>

# 云端 LLM API key（脚本不生成，从 LLM 服务商获取）：未启用云端 LLM 时留空。
SESHAT_LLM_API_KEY=<从 LLM 服务商获取，未启用则留空>
