<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- 标题行：状态徽标 + 优先级 + 标题 -->
    <LinearLayout
        android:id="@+id/entryTitleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- TODO 状态徽标：底色由适配器按状态着色 -->
        <TextView
            android:id="@+id/entryTodoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_todo_badge"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="TODO" />

        <!-- 优先级 [#A] -->
        <TextView
            android:id="@+id/entryPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textStyle="bold"
            tools:text="[#A]" />

        <!-- 标题 -->
        <TextView
            android:id="@+id/entryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:textSize="16sp"
            tools:text="实现 GTD agenda 视图" />
    </LinearLayout>

    <!-- 标签 :a:b: -->
    <TextView
        android:id="@+id/entryTags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        tools:text=":android:feature:" />

    <!-- deadline 日期 -->
    <TextView
        android:id="@+id/entryDeadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        tools:text="DEADLINE: 2026-10-20" />

</LinearLayout>
