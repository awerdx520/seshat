<?xml version="1.0" encoding="utf-8"?>
<!-- 阅读区全屏 + 顶部/底部两块半透明浮层（M10.6）：阅读区不再被标题与按钮行挤压。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 横向分页容器（HORIZONTAL 模式）；与下方竖向容器并存，按偏好显示其一 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/chapterPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 竖向连续滚动容器（M9.2）：与 ViewPager2 并存，按偏好显示其一 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chapterScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 顶部浮层：章节标题 -->
    <LinearLayout
        android:id="@+id/epubTopChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/chapterTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 底部浮层：章节进度条 + 上一章/批注/下一章 -->
    <LinearLayout
        android:id="@+id/epubBottomChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- 章节进度条（B2b）：0-based 章序号；max 运行时设为 chapterCount()-1 -->
        <SeekBar
            android:id="@+id/chapterSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="0"
            android:paddingHorizontal="12dp"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/prevChapterButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_prev_chapter" />

            <!-- 章节目录（B2c）：四个按钮平分宽度，目录固定在第 2 位（常见阅读器布局） -->
            <Button
                android:id="@+id/tocButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_toc" />

            <Button
                android:id="@+id/annotateButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_add_annotation" />

            <Button
                android:id="@+id/nextChapterButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_next_chapter" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
