<?xml version="1.0" encoding="utf-8"?>
<!-- 书架单本书卡片：封面（固定高度）+ 进度徽标 + 标题 + 作者（M10.6 B3d） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- 封面区：固定 150dp 高（项目无 ConstraintLayout 依赖，不做宽高比约束） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp">

        <!-- 封面图：中心裁剪；无封面时露出半透明底色 -->
        <ImageView
            android:id="@+id/bookCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#22000000"
            android:contentDescription="@string/shelf_no_cover"
            android:scaleType="centerCrop" />

        <!-- 进度徽标：percent 为 0 时隐藏 -->
        <TextView
            android:id="@+id/bookProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="#CC000000"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <!-- 状态徽标：未下载 / 下载中…（本地可用时隐藏，M9.2 B 批） -->
        <TextView
            android:id="@+id/bookStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="#CC000000"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/bookTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/bookAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="11sp" />

</LinearLayout>
