<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 逐页显示区：RecyclerView（横向整页吸附 / 竖向连续滚动，由代码配置） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pdfPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 底部浮层工具栏：叠加在内容之上，横屏也不挤占阅读区 -->
    <LinearLayout
        android:id="@+id/pdfChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/pdfPrevPageButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:text="@string/pdf_prev_page" />

        <TextView
            android:id="@+id/pdfPageIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:text="@string/pdf_page_indicator_placeholder" />

        <Button
            android:id="@+id/pdfNextPageButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:text="@string/pdf_next_page" />

        <Button
            android:id="@+id/pdfInkToggleButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:text="@string/pdf_ink_toggle" />

        <Button
            android:id="@+id/pdfInkUndoButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:text="@string/pdf_ink_undo" />

        <Button
            android:id="@+id/pdfInkClearButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:text="@string/pdf_ink_clear" />

        <Button
            android:id="@+id/pdfAddAnnotation"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:text="@string/pdf_add_annotation" />
    </LinearLayout>

</FrameLayout>
