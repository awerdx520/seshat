<?xml version="1.0" encoding="utf-8"?>
<!-- 阅读区全屏 + 顶部工具栏浮层 + 底部进度浮层 + 右侧手写工具栏（M10.8）：浮层是 overlay，不占布局；
     阅读区 padding 由 PdfReaderActivity.applyContentPadding() 按浮层可见性与实时高度设置。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 逐页显示区：RecyclerView（横向整页吸附 / 竖向连续滚动，由代码配置） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pdfPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部浮层：只有一行工具栏（手写参数面板已拆出为右侧竖排浮动条，不再撑高顶部栏）。
         单行即无外层容器，故 id/背景/padding 直接落在这唯一一行上（lint UselessParent）；
         insets listener 仍挂在同一个 id 上，高度语义不变。 -->
    <LinearLayout
        android:id="@+id/pdfTopChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp">

        <!-- 工具栏行：返回 | 文件名 | 手写 | 批注 | 目录 | 设置 -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="12dp"
            android:text="@string/reader_back"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/pdfTopTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pdfInkToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="12dp"
            android:text="@string/pdf_ink_toggle"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/annotateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="12dp"
            android:text="@string/pdf_add_annotation"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tocButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="12dp"
            android:text="@string/reader_toc"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="12dp"
            android:text="@string/reader_settings"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 底部浮层：页进度条 + 页码（页码可点，输入页号直接跳页） -->
    <LinearLayout
        android:id="@+id/pdfBottomChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp">

        <SeekBar
            android:id="@+id/pdfPageSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="0"
            android:paddingHorizontal="12dp"
            android:progress="0" />

        <TextView
            android:id="@+id/pdfPageIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:textColor="#FFFFFF"
            android:text="@string/pdf_page_indicator_placeholder" />
    </LinearLayout>

    <!-- 手写工具栏（M10.8）：屏幕右侧竖排浮动条，仅手写模式下显示。
         独立于 pdfTopChrome，故不参与顶部浮层高度（顶部更省地方）；圆角不做，纯色半透明背景。 -->
    <LinearLayout
        android:id="@+id/inkPanel"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:background="#E6000000"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <!-- 退出手写：点击等价于【手写】开关（面板随后由 updateInkChrome() 一并隐藏） -->
        <TextView
            android:id="@+id/inkExitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="40dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- 颜色区：2 列 × 3 行（选中态用 alpha 区分，不依赖额外 drawable） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/inkColorRed"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="#E53935"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/inkColorBlue"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="#1E88E5"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/inkColorGreen"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="#43A047"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/inkColorBlack"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="#212121"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/inkColorOrange"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="#FB8C00"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/inkColorPurple"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="#8E24AA"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 粗细：细 / 中 / 粗（竖排，每项整行宽；公共属性内联，项目无 styles.xml） -->
        <TextView
            android:id="@+id/inkWidthThin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:text="@string/pdf_ink_width_thin"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/inkWidthMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:text="@string/pdf_ink_width_medium"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/inkWidthThick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:text="@string/pdf_ink_width_thick"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- 笔型：钢笔 / 马克笔 / 荧光笔（同上） -->
        <TextView
            android:id="@+id/inkStylePen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:text="@string/pdf_ink_style_pen"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/inkStyleMarker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:text="@string/pdf_ink_style_marker"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/inkStyleHighlighter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:text="@string/pdf_ink_style_highlighter"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- 撤销 / 清空：由 updateInkChrome() 按「手写模式 + 当前页有笔迹」控制显隐 -->
        <TextView
            android:id="@+id/pdfInkUndoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:text="@string/pdf_ink_undo"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pdfInkClearButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="36dp"
            android:text="@string/pdf_ink_clear"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
