<?xml version="1.0" encoding="utf-8"?>
<!-- 笔记列表（M10.6 B4b）：搜索框 + 笔记/Agenda 分段 + 树形列表 + 底部操作区 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 全文搜索框（标题 + 正文，250ms 防抖） -->
    <EditText
        android:id="@+id/notesSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:hint="@string/notes_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:importantForAutofill="no" />

    <!-- 分段切换：笔记（树形列表）/ Agenda（按日期排序） -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/notesSegmentGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/segmentNotes"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/notes_tab_notes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/segmentAgenda"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notes_tab_agenda" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 后台加载指示 -->
    <ProgressBar
        android:id="@+id/notesLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- 空态 / 错误态（解析失败也复用此视图） -->
    <TextView
        android:id="@+id/notesEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/notes_empty"
        android:visibility="gone" />

    <!-- 树形列表；clipToPadding=false 让首个条目在滚动时也能用满 padding 区域 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/notesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- 底部操作区：同步（仅 Agenda 段显示）；GTD 页面已由 Agenda 段取代，不再提供入口按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notesSyncButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notes_sync"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
